#!/usr/bin/env bash

set -euo pipefail
test -n "${DEBUG:-}" && set -x

#cd \"${GIT_PREFIX:-.}\" git clone --filter=blob:none --no-checkout $* || hub clone --filter=blob:none --no-checkout $*

# owner urls that short names (repo, owner/repo) are looked up in, besides
# github.com/$(git config user.github). one per line, e.g. https://bondora.ghe.com/bondora
# (blank lines & #comments ignored). not committed - auto-filled with the owner
# of every repo cloned by full url; delete lines to forget owners.
OWNER_URLS_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/git-clone-wrap/owner-urls"

# short-name lookup: dir w/ the checks' results & clones, & the checks' pids
SPEC_DIR=""
CHECK_JOBS=()

git_clone_wrap() {
	ARGV=()

	while test $# -gt 0; do
		case "$1" in
			--ssh)
				shift
				export GIT_SSH_COMMAND="ssh -i \"$HOME/.ssh/$1\" -o IdentitiesOnly=yes"
				shift
				;;
			*)
				ARGV+=("$1")
				shift
				;;
		esac
	done

	# cd needed in case inside git repo:
	# without it would place cloned repo in repo root dir.
	cd "${GIT_PREFIX:-.}"

	# capture stderr, only show if all attempts fail
	local stderr_file
	stderr_file=$(mktemp)

	# extract progress reporting from stderr, show live
	filter_stderr() {
		local char="" line=""
		while IFS= read -r -n1 char || [ -n "$line" ]; do
			case "$char" in
				$'\r'|$'\n'|'')
					[ -z "$line" ] && continue
					case "$line" in
						Cloning*|remote:*|Receiving*|Resolving*|Updating*|Checking*|Enumerating*|Counting*|Compressing*|Unpacking*|*%*)
							printf '%s%s' "$line" "${char:-$'\n'}" >&2 ;;
						*)
							printf '%s\n' "$line" >>"$stderr_file" ;;
					esac
					line="" ;;
				*)
					line+="$char" ;;
			esac
		done
	}

	with_clean_stderr() {
		"$@" 2> >(filter_stderr)
	}

	# check whether url $2 exists, and if so (& $3 is set), start cloning it into $SPEC_DIR/$1/.
	# result in $SPEC_DIR/$1.check: found / missing / failed (errors in $1.err)
	check_and_clone() {
		local i="$1" url="$2" speculate="$3" result=found clone_pid=""
		# BatchMode: parallel checks must not prompt for passphrases
		if ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes" \
			git ls-remote "$url" HEAD >/dev/null 2>"$SPEC_DIR/$i.err"; then
			grep -qiE 'not found|could not be found|does not exist' "$SPEC_DIR/$i.err" && result=missing || result=failed
		elif test -n "$speculate" && mkdir "$SPEC_DIR/$i"; then
			(cd "$SPEC_DIR/$i" && exec git clone --progress "$url" "${ARGV[@]:1}") 2>"$SPEC_DIR/$i.progress" &
			clone_pid=$!
		fi
		echo "$result" > "$SPEC_DIR/$i.check"
		if test -n "$clone_pid"; then
			wait "$clone_pid" && echo 0 > "$SPEC_DIR/$i.exit" || echo $? > "$SPEC_DIR/$i.exit"
		fi
	}

	# stop a match's clone & remove it
	abort_clone() {
		pkill -P "${CHECK_JOBS[$1]}" 2>/dev/null || true
		wait "${CHECK_JOBS[$1]}" 2>/dev/null || true
		rm -rf "${SPEC_DIR:?}/$1"
	}

	# show the progress of an already running clone, then move it into place
	finish_clone() {
		local i="$1" tail_pid entry
		tail -n +1 -f "$SPEC_DIR/$i.progress" 2>/dev/null > >(filter_stderr) &
		tail_pid=$!
		while ! test -s "$SPEC_DIR/$i.exit"; do sleep 0.2; done
		sleep 0.2 # let tail catch up
		kill "$tail_pid" 2>/dev/null || true
		if test "$(cat "$SPEC_DIR/$i.exit")" != 0; then
			tr '\r' '\n' < "$SPEC_DIR/$i.progress" >> "$stderr_file"
			return 1
		fi
		entry=$(ls -A "$SPEC_DIR/$i")
		if test -e "$entry"; then
			echo "fatal: destination path '$entry' already exists" >> "$stderr_file"
			return 1
		fi
		mv "$SPEC_DIR/$i/$entry" .
	}

	# short names (repo, owner/repo): check all candidate urls in parallel, and start
	# cloning each match right away, so a slow check doesn't hold the others up.
	# once all checks are in, one match is kept, several prompt & the rest get aborted.
	# sets $url, and $pick if its clone is already running.
	lookup_short_name() {
		local -a candidates=() found=() found_urls=() reported=()
		local i j arg n=0 speculate=1
		while IFS= read -r url; do candidates+=("$url"); done < <(short_name_candidates "${ARGV[0]}")
		url=""
		test ${#candidates[@]} -gt 0 || return 0

		if test ${#ARGV[@]} -eq 1 && test -e "$(basename "${ARGV[0]}" .git)"; then
			echo "fatal: destination path '$(basename "${ARGV[0]}" .git)' already exists" >&2
			return 1
		fi
		# extra args may be paths, which'd break when cloning elsewhere - clone after the pick then
		for arg in "${ARGV[@]:1}"; do
			case "$arg" in */*|~*|--separate-git-dir*|--reference*|--template*) speculate="" ;; esac
		done

		# in cwd, so the picked clone can be moved out instantly
		SPEC_DIR=$(mktemp -d "./.git-clone-wrap.XXXXXX") || return 1
		trap cleanup_spec EXIT
		trap 'exit 130' INT TERM
		echo "looking up ${ARGV[0]} in ${#candidates[@]} places..." >&2
		for i in "${!candidates[@]}"; do
			# (no "Terminated" noise when aborted)
			check_and_clone "$i" "${candidates[$i]}" "$speculate" 2>/dev/null &
			CHECK_JOBS[$i]=$!
		done

		# report matches & failed checks as they come in
		while test $n -lt ${#candidates[@]}; do
			for i in "${!candidates[@]}"; do
				test -z "${reported[$i]:-}" && test -s "$SPEC_DIR/$i.check" || continue
				reported[$i]=1
				n=$((n + 1))
				case "$(cat "$SPEC_DIR/$i.check")" in
					found) found+=("$i"); echo "  found        ${candidates[$i]}" >&2 ;;
					failed) echo "  check failed ${candidates[$i]}: $(head -1 "$SPEC_DIR/$i.err")" >&2 ;;
				esac
			done
			if test $n -lt ${#candidates[@]}; then sleep 0.2; fi
		done

		case ${#found[@]} in
			0) echo "  no match" >&2; return 0 ;;
			1) i="${found[0]}" ;;
			*)
				for j in "${found[@]}"; do found_urls+=("${candidates[$j]}"); done
				echo "multiple matches (to forget an owner, delete it from $OWNER_URLS_FILE):" >&2
				url=$(pick_url "${found_urls[@]}") || {
					echo "clone one by full url:" >&2
					printf '  %s\n' "${found_urls[@]}" >&2
					return 1
				}
				for j in "${found[@]}"; do
					if test "${candidates[$j]}" = "$url"; then i=$j; else abort_clone "$j"; fi
				done
				;;
		esac
		url="${candidates[$i]}"
		if test -n "$speculate"; then pick="$i"; fi
	}

	local url="" pick=""
	if is_short_name "${ARGV[0]}" && ! test -e "${ARGV[0]}"; then
		lookup_short_name || { rm -f "$stderr_file"; return 1; }
	fi

	{
		if test -n "$pick"; then
			finish_clone "$pick"
		elif test -n "$url"; then
			with_clean_stderr git clone --progress "$url" "${ARGV[@]:1}"
		else
			with_clean_stderr git clone --progress "$(https_to_ssh_url "${ARGV[0]}")" "${ARGV[@]:1}" || \
			with_clean_stderr git clone --progress "${ARGV[@]}" || \
			with_clean_stderr hub clone --progress "${ARGV[@]}"
		fi
	} \
	&& { echo "done" >&2; rm -f "$stderr_file"; remember_owner_url "${ARGV[0]}"; return 0; } \
	|| { echo "failed. see errors in" >&2; echo "$stderr_file"; return 1; }
}

https_to_ssh_url() {
	# GHE.com (enterprise w/ data residency) uses the subdomain as ssh user, not "git":
	# https://bondora.ghe.com/org/repo -> bondora@bondora.ghe.com:org/repo
	echo "$1" | sed -E 's#^([a-z]+://)?([^./@]+)\.ghe\.com/#\2@\2.ghe.com/#; s#.*://#git@#g; s#/#:#'
}

# repo or owner/repo, as opposed to a full url or a path
is_short_name() {
	case "$1" in *://*|*@*|*:*|*/*/*|.*|/*|~*|'') return 1 ;; esac
}

# ssh urls a short name could refer to: remembered owners, then github.com
short_name_candidates() {
	local repo="$1" url user
	{
		while IFS= read -r url; do https_to_ssh_url "$url"; done < <(owner_candidates "$repo")
		case "$repo" in
			*/*) echo "git@github.com:$repo" ;;
			*) user=$(git config user.github) && echo "git@github.com:$user/$repo" ;;
		esac
	} | awk '!seen[$0]++'
}

# abort checks & clones of a short-name lookup still running, & remove their dirs
cleanup_spec() {
	local i
	test -n "$SPEC_DIR" && test -d "$SPEC_DIR" || return 0
	for i in "${!CHECK_JOBS[@]}"; do
		# still checking, or still cloning
		if ! test -s "$SPEC_DIR/$i.check" || { test -d "$SPEC_DIR/$i" && ! test -s "$SPEC_DIR/$i.exit"; }; then
			pkill -P "${CHECK_JOBS[$i]}" 2>/dev/null || true
		fi
	done
	wait
	rm -rf "$SPEC_DIR" 2>/dev/null || { sleep 1; rm -rf "$SPEC_DIR"; }
}

# let the user pick one of several urls (needs a terminal)
pick_url() {
	local PS3="clone which? " url
	( : </dev/tty ) 2>/dev/null || return 1
	select url in "$@"; do
		test -n "$url" && { echo "$url"; return 0; }
	done </dev/tty
	return 1
}

# repo       -> <url>/repo
# owner/repo -> <url's host>/owner/repo
owner_candidates() {
	local repo="$1" url
	is_short_name "$repo" || return 0
	test -f "$OWNER_URLS_FILE" || return 0
	grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$OWNER_URLS_FILE" | sed 's#/*$##' | while IFS= read -r url; do
		case "$repo" in
			*/*) echo "$(echo "$url" | sed -E 's#^(([a-z]+://)?[^/]+).*#\1#')/$repo" ;;
			*) echo "$url/$repo" ;;
		esac
	done | awk '!seen[$0]++'
}

# remember owner url of a repo cloned by full url, for later short-name clones:
# https://github.com/owner/repo, git@github.com:owner/repo.git -> https://github.com/owner
remember_owner_url() {
	local url
	case "$1" in file://*) return 0 ;; esac
	test -e "$1" && return 0 # local path
	url=$(echo "${1%/}" | sed -nE 's#^([a-z+]+://)?([^@/]+@)?([^/:@]+\.[^/:@]+)[/:](.+)/[^/]+$#https://\3/\4#p')
	test -n "$url" || return 0
	grep -qxF "$url" "$OWNER_URLS_FILE" 2>/dev/null && return 0
	mkdir -p "$(dirname "$OWNER_URLS_FILE")"
	echo "$url" >> "$OWNER_URLS_FILE"
	echo "remembered $url for short-name clones (delete it from $OWNER_URLS_FILE to forget)" >&2
}

git_clone_wrap "$@"
exit $?
